# Docker ignore file - exclude unnecessary files from Docker build

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.log

# Virtual environments
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Jupyter Notebook
.ipynb_checkpoints

# Git
.git/
.gitignore
.gitattributes

# Large datasets (download separately or mount)
datasets/google-2011/
datasets/google-2019/
datasets/alibaba-2018/
*.tar.gz
*.zip
*.csv.gz

# Temporary files
*.tmp
*.bak
*.cache
.pytest_cache/
.coverage
htmlcov/

# OS files
Thumbs.db
.DS_Store

# Documentation build artifacts
docs/_build/
site/

# Docker files (don't include in image)
Dockerfile
docker-compose.yml
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Large output files
*.png
*.jpg
*.jpeg
*.pkl
*.h5
*.hdf5

# Keep structure but ignore large binaries
models/*.pkl
output/plots/*.png
